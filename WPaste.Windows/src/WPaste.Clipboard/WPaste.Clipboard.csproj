<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WPaste.Clipboard</RootNamespace>
    <AssemblyName>WPaste.Clipboard</AssemblyName>
    <Description>剪贴板监听、解析、PrivacyFilter</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\WPaste.Platform\NativeMethods.txt" Link="NativeMethods.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WPaste.Core\WPaste.Core.csproj" />
    <ProjectReference Include="..\WPaste.Platform\WPaste.Platform.csproj" />
  </ItemGroup>

</Project>
